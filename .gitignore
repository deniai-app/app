# dependencies
/node_modules
.vx
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# react-doctor scan output (regenerate with `bun run doctor`; stale copies mislead)
.diagnostics.json
.errors_by_file.json

# claude
.claude-images/
# next-agents-md
.next-docs/

# internal one-off scripts (local only, may touch prod secrets)
internal/
