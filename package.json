{
  "name": "deni-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "auth:generate": "auth generate --output src/db/schema/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.production ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:dev": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "oauth:example": "tsx --env-file-if-exists=.env.local examples/sign-in-with-deni-ai.ts",
    "oauth:test": "tsx --env-file=.env.local tools/test-deni-ai-oauth.ts",
    "db:push": "drizzle-kit push",
    "tools:codename": "tsx --env-file-if-exists=.env.local ./tools/codename-generator.ts",
    "tools:update-types": "tsx ./tools/update-types.ts",
    "tools:stripe-max-mode": "tsx --env-file-if-exists=.env.local ./tools/stripe-max-mode-setup.ts",
    "tools:commit": "tsx --env-file-if-exists=.env.local ./tools/commit.ts",
    "tools:purge-anonymous": "tsx --env-file=.env.production ./tools/purge-anonymous.ts",
    "disposable:refresh": "pnpm --filter @deni-ai/disposable-email-domains refresh",
    "test": "vitest run",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/groq": "^4.0.53",
    "@ai-sdk/openai": "^4.0.82",
    "@ai-sdk/react": "^4.0.126",
    "@ai-sdk/xai": "^5.0.13",
    "@base-ui/react": "^1.8.0",
    "@better-auth-ui/core": "^1.7.26",
    "@better-auth-ui/react": "^1.7.26",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@better-auth/oauth-provider": "1.7.6",
    "@better-auth/passkey": "^1.7.6",
    "@deni-ai/disposable-email-domains": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/third-parties": "^16.3.7",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/react-query": "^5.104.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.123",
    "better-auth": "^1.7.6",
    "bowser": "^2.14.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cmdk-base": "^1.0.0",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "nanoid": "^6.0.1",
    "next": "^16.3.7",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "stripe": "^22.6.2",
    "sucrase": "^3.35.1",
    "sugar-high": "^2.5.0",
    "superjson": "^2.2.6",
    "uploadthing": "^7.7.4",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "^1.7.6",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react-doctor": "^0.9.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.8.1"
}
